# API Configuration
VITE_API_BASE_URL=http://localhost:3001

# App Configuration
VITE_APP_NAME=Ride Share MVP
VITE_APP_VERSION=1.0.0

# Feature Flags
VITE_ENABLE_MAPS=true
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_GPS=true

# Development
VITE_DEBUG_MODE=false
VITE_LOG_LEVEL=warn

# Polling Configuration
VITE_POLLING_INTERVAL=5000

# Map Configuration
VITE_DEFAULT_MAP_CENTER_LAT=37.7749
VITE_DEFAULT_MAP_CENTER_LNG=-122.4194
VITE_DEFAULT_MAP_ZOOM=12

# Location Settings
VITE_DEFAULT_WALK_DISTANCE=1000
VITE_MAX_WALK_DISTANCE=2000

# Routing API (Optional - for better route quality)
VITE_ORS_API_KEY=